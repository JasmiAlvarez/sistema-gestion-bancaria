# ============================================================
# Configuración del servidor - Sistema Bancario
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas tu archivo .env a GitHub.
# ============================================================

# Cadena de conexión de MongoDB Atlas (o MongoDB local con replica set).
# Atlas (reemplaza USUARIO, CLAVE y CLUSTER por tus datos):
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/banco?retryWrites=true&w=majority

# Alternativa con MongoDB local (replica set):
# MONGODB_URI=mongodb://127.0.0.1:27017/banco?replicaSet=rs0

# Puerto del API REST
PORT=5000

# Origen permitido por CORS (frontend de Vite)
CLIENT_URL=http://localhost:5173

# Opcional: cadena exclusiva para las pruebas automatizadas.
# Si se omite, se deriva de MONGODB_URI agregando el sufijo _test.
# MONGODB_URI_TEST=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/banco_test?retryWrites=true&w=majority
